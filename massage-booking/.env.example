# ---------------------------------------------------------------------------
# データベース（Supabase / PostgreSQL）
#
# Supabase の管理画面 → Project Settings → Database → Connection string から取得する。
# **接続先が 2 つある。役割が違うので両方を設定する。**
# ---------------------------------------------------------------------------

# アプリが普段使う接続。「Connection pooling」側（ポート 6543）。
# Vercel は関数が呼ばれるたびに別インスタンスが立ち上がるため、直結すると接続数が上限に達する。
# 末尾の ?pgbouncer=true&connection_limit=1 は必須（外すと
# 「prepared statement "s0" already exists」で失敗する）。
DATABASE_URL="postgresql://postgres.xxxxxxxx:パスワード@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# マイグレーション専用の接続。「Direct connection」側（ポート 5432）。
# prisma migrate はテーブルの作り替えをするため pooler を通せない。
DIRECT_URL="postgresql://postgres.xxxxxxxx:パスワード@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# タイムゾーン（必須）
#
# 予約の日時はローカル時刻で組み立てているため、UTC のままだと 9 時間ずれる。
# Vercel の実行環境は既定が UTC なので、**Vercel の環境変数にも必ず設定する**。
# ---------------------------------------------------------------------------
TZ="Asia/Tokyo"

# ---------------------------------------------------------------------------
# セッション
#
# ログイン状態の Cookie に署名するための秘密の文字列（16 文字以上）。
# 各自の手元で次のコマンドを実行し、出た値を .env に書く。この値はコミットしない。
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
SESSION_SECRET="ここに生成した値を貼る"

# ---------------------------------------------------------------------------
# Web プッシュ通知（任意。設定しなければ通知機能だけが無効になる）
#   npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""

# ---------------------------------------------------------------------------
# Slack 通知（予約確定・キャンセル・毎朝のリマインド、AC-11 / AC-12 / AC-18）
#
# Slack App の Bot Token（xoxb- で始まる）。scope は users:read.email と chat:write。
# 未設定だと通知処理はログを出すだけで何もしない（予約自体は失敗しない）。
# ---------------------------------------------------------------------------
# SLACK_BOT_TOKEN=""

# ---------------------------------------------------------------------------
# リマインド用 cron エンドポイントの保護（毎朝の一括通知、AC-12）
#
# `/api/cron/remind` を叩けるのは `Authorization: Bearer <CRON_SECRET>` を
# 付けたリクエストだけ。未設定なら常に拒否する（フェイルクローズ）。
# Vercel の Cron Jobs はこの環境変数を設定するだけで、そのヘッダーを自動で付けて呼んでくれる。
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
# CRON_SECRET=""

# ---------------------------------------------------------------------------
# リマインド通知内の「予約一覧へ戻る」リンクの起点（任意）
#
# 未設定でも Vercel 本番環境なら自動でその本番ドメインを使う（VERCEL_PROJECT_PRODUCTION_URL）。
# それ以外の環境で明示したい場合だけ設定する。
# ---------------------------------------------------------------------------
# APP_BASE_URL="https://example.vercel.app"
